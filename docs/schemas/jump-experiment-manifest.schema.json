{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/perfect7613/jump-research/blob/main/docs/schemas/jump-experiment-manifest.schema.json",
  "title": "JUMP experiment manifest",
  "description": "Normative structural contract for preregistered, sequential, resumable JUMP experiments. Cross-field scientific invariants are enforced by semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "budget",
    "reproducibility",
    "data",
    "checkpoints",
    "conditions",
    "extraction",
    "probes",
    "swaps",
    "interventions",
    "mediation",
    "metrics",
    "gates",
    "execution",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "track",
        "owner",
        "analysis_class",
        "status",
        "created_at",
        "code_commit",
        "lockfile_sha256",
        "preregistration"
      ],
      "properties": {
        "experiment_id": { "$ref": "#/$defs/slug" },
        "track": { "enum": ["H", "R"] },
        "owner": { "type": "string", "minLength": 1 },
        "analysis_class": { "enum": ["exploratory", "confirmatory"] },
        "status": { "enum": ["draft", "locked", "running", "completed", "pivoted", "killed"] },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "parent_manifest_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "code_commit": { "$ref": "#/$defs/gitSha" },
        "lockfile_sha256": { "$ref": "#/$defs/sha256" },
        "preregistration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri", "immutable_ref"],
          "properties": {
            "kind": { "enum": ["osf", "timestamped_git_commit", "other_immutable_registry"] },
            "uri": { "type": "string", "pattern": "^https://[^\\s]+$" },
            "immutable_ref": { "type": "string", "minLength": 7 }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "verified_credits",
        "project_ceiling",
        "workspace_hard_ceiling",
        "environment_ceiling",
        "ordinary_stop",
        "track_ceiling",
        "forecast_fraction_limit",
        "max_gpu_seconds",
        "max_retries_per_shard",
        "gpu_allowlist",
        "h100_policy",
        "one_active_gpu_stage"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "verified_credits": { "const": 188 },
        "project_ceiling": { "type": "number", "exclusiveMinimum": 0, "maximum": 175 },
        "workspace_hard_ceiling": { "const": 175 },
        "environment_ceiling": { "const": 165 },
        "ordinary_stop": { "const": 160 },
        "track_ceiling": { "type": "number", "exclusiveMinimum": 0, "maximum": 98 },
        "forecast_fraction_limit": { "const": 0.8 },
        "max_gpu_seconds": { "type": "integer", "minimum": 1 },
        "max_retries_per_shard": { "type": "integer", "minimum": 0, "maximum": 3 },
        "gpu_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["T4", "L4", "A10", "L40S", "A100-80GB", "H100"] }
        },
        "h100_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted_stage_ids",
            "minimum_cheaper_smoke_fraction",
            "requires_measured_memory",
            "requires_measured_runtime",
            "requires_comparative_cost_forecast",
            "requires_stage_hard_caps",
            "requires_sequential_execution",
            "approval_roles"
          ],
          "properties": {
            "permitted_stage_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "world_representation",
                  "activation_extraction",
                  "matched_swaps",
                  "causal_interventions",
                  "mediation",
                  "ood_evaluation",
                  "checkpoint_replication"
                ]
              }
            },
            "minimum_cheaper_smoke_fraction": { "const": 0.01 },
            "requires_measured_memory": { "const": true },
            "requires_measured_runtime": { "const": true },
            "requires_comparative_cost_forecast": { "const": true },
            "requires_stage_hard_caps": { "const": true },
            "requires_sequential_execution": { "const": true },
            "approval_roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["research_lead", "operations_budget_owner"] },
              "allOf": [
                { "contains": { "const": "research_lead" } },
                { "contains": { "const": "operations_budget_owner" } }
              ]
            }
          }
        },
        "one_active_gpu_stage": { "const": true },
        "phase_ceilings": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_seed",
        "component_seeds",
        "deterministic_algorithms",
        "container_digest",
        "hardware_class",
        "precision",
        "quantization"
      ],
      "properties": {
        "global_seed": { "$ref": "#/$defs/seed" },
        "component_seeds": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": { "$ref": "#/$defs/seed" }
        },
        "deterministic_algorithms": { "const": true },
        "container_digest": { "$ref": "#/$defs/digest" },
        "hardware_class": { "enum": ["CPU", "T4", "L4", "A10", "L40S", "A100-80GB", "H100"] },
        "precision": { "enum": ["fp32", "bf16", "fp16"] },
        "quantization": { "enum": ["none", "int8", "int4"] }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_version",
        "object_count",
        "hidden_type_count",
        "exponent_values",
        "families",
        "splits",
        "paired_episode_ids",
        "exclusion_reasons"
      ],
      "properties": {
        "generator_version": { "type": "string", "minLength": 1 },
        "object_count": { "const": 6 },
        "hidden_type_count": { "const": 2 },
        "exponent_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 8 }
        },
        "families": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "role", "generator_parameters_sha256", "sample_count"],
            "properties": {
              "family_id": { "$ref": "#/$defs/slug" },
              "role": { "enum": ["id_train", "id_validation", "id_test", "ood_confirmatory"] },
              "generator_parameters_sha256": { "$ref": "#/$defs/sha256" },
              "sample_count": { "type": "integer", "minimum": 1 }
            }
          },
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "ood_confirmatory" } },
            "required": ["role"]
          }
        },
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test", "ood"],
          "properties": {
            "train": { "$ref": "#/$defs/split" },
            "validation": { "$ref": "#/$defs/split" },
            "test": { "$ref": "#/$defs/split" },
            "ood": { "$ref": "#/$defs/split" }
          }
        },
        "paired_episode_ids": { "const": true },
        "exclusion_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "$ref": "#/$defs/checkpoint" },
        "secondary": { "$ref": "#/$defs/checkpoint" }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/condition" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/conditionA" } },
        { "contains": { "$ref": "#/$defs/conditionB" } },
        { "contains": { "$ref": "#/$defs/conditionC" } },
        { "contains": { "$ref": "#/$defs/conditionCPrime" } },
        { "contains": { "$ref": "#/$defs/conditionD" } },
        { "contains": { "$ref": "#/$defs/conditionE" } },
        { "contains": { "$ref": "#/$defs/conditionF" } },
        { "contains": { "$ref": "#/$defs/conditionG" } },
        { "contains": { "$ref": "#/$defs/conditionH" } },
        { "contains": { "$ref": "#/$defs/conditionI" } },
        { "contains": { "$ref": "#/$defs/conditionJ" } },
        { "contains": { "$ref": "#/$defs/controlNoHidden" } },
        { "contains": { "$ref": "#/$defs/controlPermuted" } }
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "layers",
        "timepoints",
        "sentinel_policy",
        "dtype",
        "format",
        "shard_size"
      ],
      "properties": {
        "stream": { "const": "residual_post_block" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "timepoints": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/timepoint" },
          "allOf": [
            { "contains": { "type": "object", "properties": { "id": { "const": "T0" } }, "required": ["id"] } },
            { "contains": { "type": "object", "properties": { "id": { "const": "T1" } }, "required": ["id"] } },
            { "contains": { "type": "object", "properties": { "id": { "const": "T2" } }, "required": ["id"] } },
            { "contains": { "type": "object", "properties": { "id": { "const": "T3" } }, "required": ["id"] } },
            { "contains": { "type": "object", "properties": { "id": { "const": "T4" } }, "required": ["id"] } }
          ]
        },
        "sentinel_policy": { "const": "fail_closed_exactly_one_token_boundary" },
        "dtype": { "enum": ["fp32", "bf16", "fp16"] },
        "format": { "enum": ["safetensors", "zarr"] },
        "shard_size": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/probe" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "probe_id": { "const": "mismatch" } }, "required": ["probe_id"] } },
        { "contains": { "type": "object", "properties": { "probe_id": { "const": "inadequacy" } }, "required": ["probe_id"] } },
        { "contains": { "type": "object", "properties": { "probe_id": { "const": "promotion" } }, "required": ["probe_id"] } }
      ]
    },
    "swaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_keys", "matched_fields", "exclude_coincident_targets", "both_directions", "metrics"],
      "properties": {
        "pairing_keys": { "$ref": "#/$defs/nonEmptyStringArray" },
        "matched_fields": { "$ref": "#/$defs/nonEmptyStringArray" },
        "exclude_coincident_targets": { "const": true },
        "both_directions": { "const": true },
        "metrics": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "interventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_selection_rule",
        "operators",
        "scale_rule",
        "scale_sweep",
        "controls",
        "temperature",
        "orthogonality_tolerance"
      ],
      "properties": {
        "site_selection_rule": { "const": "earliest_passing_then_shallowest_then_lexicographic" },
        "operators": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "items": { "enum": ["subspace_ablation", "activation_injection", "activation_patch"] },
          "allOf": [
            { "contains": { "const": "subspace_ablation" } },
            { "contains": { "const": "activation_injection" } }
          ]
        },
        "scale_rule": { "const": "median_native_projection_norm" },
        "scale_sweep": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
        },
        "controls": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["matched_norm_random", "orthogonal", "generic_error", "sham"] },
          "allOf": [
            { "contains": { "const": "matched_norm_random" } },
            { "contains": { "const": "orthogonal" } },
            { "contains": { "const": "generic_error" } },
            { "contains": { "const": "sham" } }
          ]
        },
        "generic_error_subtypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["surprise", "uncertainty", "negation", "factual_error"] }
        },
        "temperature": { "const": 0 },
        "orthogonality_tolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.00001 }
      }
    },
    "mediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "ordered_mediators",
        "outcome",
        "estimator",
        "bootstrap_unit",
        "bootstrap_resamples",
        "confidence_level",
        "minimum_mediated_proportion",
        "sensitivity_controls"
      ],
      "properties": {
        "treatment": { "const": "true_latent_vs_scrambled_or_wrong_latent" },
        "ordered_mediators": {
          "type": "array",
          "prefixItems": [
            { "const": "inadequacy_activation" },
            { "const": "promotion_activation" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "outcome": { "const": "exact_correct_revision" },
        "estimator": { "enum": ["activation_clamped_g_computation", "activation_patching_difference"] },
        "bootstrap_unit": { "const": "episode_world_seed" },
        "bootstrap_resamples": { "type": "integer", "minimum": 10000 },
        "confidence_level": { "const": 0.95 },
        "minimum_mediated_proportion": { "const": 0.2 },
        "sensitivity_controls": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["matched_norm_random", "orthogonal", "generic_error", "sham"] },
          "allOf": [
            { "contains": { "const": "matched_norm_random" } },
            { "contains": { "const": "orthogonal" } },
            { "contains": { "const": "generic_error" } },
            { "contains": { "const": "sham" } }
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_ids", "principal_comparisons", "bootstrap", "equivalence", "multiplicity", "calibration_bins", "nrmse_epsilon"],
      "properties": {
        "metric_ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 12,
          "items": { "$ref": "#/$defs/slug" },
          "allOf": [
            { "contains": { "const": "partition_accuracy" } },
            { "contains": { "const": "full_law_accuracy" } },
            { "contains": { "const": "joint_theory_accuracy" } },
            { "contains": { "const": "force_prediction_nrmse" } },
            { "contains": { "const": "adequacy_balanced_accuracy" } },
            { "contains": { "const": "false_abduction_rate" } },
            { "contains": { "const": "brier_score" } },
            { "contains": { "const": "ece_10" } },
            { "contains": { "const": "probe_auc" } },
            { "contains": { "const": "swap_donor_directional_success" } },
            { "contains": { "const": "intervention_effect" } },
            { "contains": { "const": "mediation_nie" } },
            { "contains": { "const": "ood_retention" } },
            { "contains": { "const": "provenance_correctness" } }
          ]
        },
        "principal_comparisons": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["E-G", "E-C_prime", "E-I", "B-E", "E-training_no_hidden", "E-training_permuted"] },
          "allOf": [
            { "contains": { "const": "E-G" } },
            { "contains": { "const": "E-C_prime" } },
            { "contains": { "const": "E-I" } },
            { "contains": { "const": "B-E" } },
            { "contains": { "const": "E-training_no_hidden" } },
            { "contains": { "const": "E-training_permuted" } }
          ]
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "cluster", "resamples", "confidence_level", "seed"],
          "properties": {
            "method": { "const": "percentile" },
            "cluster": { "const": "episode_world_seed" },
            "resamples": { "type": "integer", "minimum": 10000 },
            "confidence_level": { "const": 0.95 },
            "seed": { "$ref": "#/$defs/seed" }
          }
        },
        "equivalence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "alpha", "lower_percentage_points", "upper_percentage_points"],
          "properties": {
            "method": { "const": "two_one_sided_tests" },
            "alpha": { "const": 0.05 },
            "lower_percentage_points": { "const": -3 },
            "upper_percentage_points": { "const": 3 }
          }
        },
        "multiplicity": { "const": "benjamini_hochberg_fdr_0.05_per_probe_family" },
        "calibration_bins": { "const": 10 },
        "nrmse_epsilon": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/gate" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G0" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G1" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G2" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G3" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G4" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G5" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G6" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G7" } }, "required": ["gate_id"] } },
        { "contains": { "type": "object", "properties": { "gate_id": { "const": "G8" } }, "required": ["gate_id"] } }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequential",
        "max_active_gpu_stages",
        "idempotency_fields",
        "stages",
        "checkpoint_policy",
        "resume_policy",
        "state_values",
        "atomic_promotion",
        "stop_on_gate"
      ],
      "properties": {
        "sequential": { "const": true },
        "max_active_gpu_stages": { "const": 1 },
        "idempotency_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["manifest_sha256", "code_commit", "input_sha256s", "checkpoint_revision", "stage_id", "shard_id"] },
          "allOf": [
            { "contains": { "const": "manifest_sha256" } },
            { "contains": { "const": "code_commit" } },
            { "contains": { "const": "input_sha256s" } },
            { "contains": { "const": "checkpoint_revision" } },
            { "contains": { "const": "stage_id" } },
            { "contains": { "const": "shard_id" } }
          ]
        },
        "stages": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/stage" },
          "allOf": [
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "preflight" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "data_and_scorer" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "behavioral_regime" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "world_representation" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "condition_matrix" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "activation_extraction" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "probe_localization" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "matched_swaps" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "causal_interventions" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "mediation" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "ood_evaluation" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "checkpoint_replication" } }, "required": ["stage_id"] } },
            { "contains": { "type": "object", "properties": { "stage_id": { "const": "release" } }, "required": ["stage_id"] } }
          ]
        },
        "checkpoint_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inference_max_episodes", "inference_max_minutes", "training_max_minutes", "save_rng_state", "save_data_cursor"],
          "properties": {
            "inference_max_episodes": { "type": "integer", "minimum": 1, "maximum": 25 },
            "inference_max_minutes": { "type": "integer", "minimum": 1, "maximum": 5 },
            "training_max_minutes": { "type": "integer", "minimum": 1, "maximum": 10 },
            "save_rng_state": { "const": true },
            "save_data_cursor": { "const": true }
          }
        },
        "resume_policy": { "const": "verify_and_skip_valid_completed_shards" },
        "state_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PENDING",
              "RUNNING",
              "SUCCEEDED",
              "FAILED_RETRYABLE",
              "FAILED_TERMINAL",
              "PASSED_GATE",
              "PIVOT_REQUIRED",
              "KILLED",
              "SKIPPED_BY_GATE"
            ]
          },
          "minItems": 9,
          "maxItems": 9
        },
        "atomic_promotion": { "const": true },
        "stop_on_gate": { "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "resolved_manifest" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "cost_ledger" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "gate_decisions" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "structured_outputs" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "activation_index" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "probe_results" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "swap_results" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "intervention_results" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "mediation_results" } }, "required": ["artifact_type"] } },
        { "contains": { "type": "object", "properties": { "artifact_type": { "const": "reproducibility_report" } }, "required": ["artifact_type"] } }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "type": "object",
            "properties": {
              "track": { "const": "R" },
              "analysis_class": { "const": "confirmatory" }
            },
            "required": ["track", "analysis_class"]
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "type": "object",
            "properties": { "status": { "enum": ["locked", "running", "completed", "pivoted", "killed"] } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "stages": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "gpu_class": { "const": "H100" } },
                  "required": ["gpu_class"]
                }
              }
            },
            "required": ["stages"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "budget": {
            "type": "object",
            "properties": {
              "gpu_allowlist": { "type": "array", "contains": { "const": "H100" } }
            }
          },
          "artifacts": {
            "type": "array",
            "allOf": [
              { "contains": { "type": "object", "properties": { "artifact_type": { "const": "h100_preflight" } }, "required": ["artifact_type"] } },
              { "contains": { "type": "object", "properties": { "artifact_type": { "const": "h100_approval" } }, "required": ["artifact_type"] } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "world_seed_count", "episode_count"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "world_seed_count": { "type": "integer", "minimum": 1 },
        "episode_count": { "type": "integer", "minimum": 1 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "tokenizer_revision",
        "license_decision",
        "layer_count",
        "resolved_layers",
        "hook_map_sha256",
        "frozen_base",
        "precision",
        "quantization"
      ],
      "properties": {
        "model_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "revision": { "$ref": "#/$defs/gitSha" },
        "tokenizer_revision": { "$ref": "#/$defs/gitSha" },
        "license_decision": { "enum": ["approved_internal_only", "approved_public_derivatives", "approved_no_derivatives"] },
        "layer_count": { "type": "integer", "minimum": 2 },
        "resolved_layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "hook_map_sha256": { "$ref": "#/$defs/sha256" },
        "frozen_base": { "const": true },
        "precision": { "enum": ["fp32", "bf16", "fp16"] },
        "quantization": { "enum": ["none", "int8", "int4"] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "prompt_template_sha256",
        "token_budget",
        "latent_source",
        "adapter_objective",
        "trainable_parameter_count",
        "temperature"
      ],
      "properties": {
        "condition_id": {
          "enum": ["A", "B", "C", "C_prime", "D", "E", "F", "G", "H", "I", "J", "training_no_hidden", "training_permuted"]
        },
        "prompt_template_sha256": { "$ref": "#/$defs/sha256" },
        "token_budget": { "type": "integer", "minimum": 1 },
        "latent_source": {
          "enum": ["none", "true_world", "scrambled", "random", "no_hidden_world_model", "permuted_episode"]
        },
        "adapter_objective": {
          "enum": ["none", "neutral_description_next_token", "disclosed_task_answer_loss", "same_parameter_control"]
        },
        "trainable_parameter_count": { "type": "integer", "minimum": 0 },
        "temperature": { "const": 0 }
      }
    },
    "conditionA": { "type": "object", "properties": { "condition_id": { "const": "A" } }, "required": ["condition_id"] },
    "conditionB": { "type": "object", "properties": { "condition_id": { "const": "B" } }, "required": ["condition_id"] },
    "conditionC": { "type": "object", "properties": { "condition_id": { "const": "C" } }, "required": ["condition_id"] },
    "conditionCPrime": { "type": "object", "properties": { "condition_id": { "const": "C_prime" } }, "required": ["condition_id"] },
    "conditionD": { "type": "object", "properties": { "condition_id": { "const": "D" } }, "required": ["condition_id"] },
    "conditionE": { "type": "object", "properties": { "condition_id": { "const": "E" } }, "required": ["condition_id"] },
    "conditionF": { "type": "object", "properties": { "condition_id": { "const": "F" } }, "required": ["condition_id"] },
    "conditionG": { "type": "object", "properties": { "condition_id": { "const": "G" } }, "required": ["condition_id"] },
    "conditionH": { "type": "object", "properties": { "condition_id": { "const": "H" } }, "required": ["condition_id"] },
    "conditionI": { "type": "object", "properties": { "condition_id": { "const": "I" } }, "required": ["condition_id"] },
    "conditionJ": { "type": "object", "properties": { "condition_id": { "const": "J" } }, "required": ["condition_id"] },
    "controlNoHidden": { "type": "object", "properties": { "condition_id": { "const": "training_no_hidden" } }, "required": ["condition_id"] },
    "controlPermuted": { "type": "object", "properties": { "condition_id": { "const": "training_permuted" } }, "required": ["condition_id"] },
    "timepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sentinel", "position"],
      "properties": {
        "id": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
        "sentinel": { "type": "string", "minLength": 1 },
        "position": { "const": "final_token_before_output_or_after_block" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "model",
        "label_definition",
        "group_keys",
        "normalization",
        "nested_cv_folds",
        "regularization_grid",
        "threshold_rule",
        "minimum_per_class",
        "metrics"
      ],
      "properties": {
        "probe_id": { "enum": ["mismatch", "inadequacy", "promotion"] },
        "model": { "enum": ["l2_logistic", "l2_multinomial_logistic"] },
        "label_definition": { "type": "string", "minLength": 8 },
        "group_keys": { "$ref": "#/$defs/nonEmptyStringArray" },
        "normalization": { "const": "train_only_zscore" },
        "nested_cv_folds": { "type": "integer", "minimum": 3, "maximum": 10 },
        "regularization_grid": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "threshold_rule": { "const": "training_youden_j" },
        "minimum_per_class": { "type": "integer", "minimum": 20 },
        "metrics": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "order", "expression", "on_pass", "on_pivot", "on_kill"],
      "properties": {
        "gate_id": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 8 },
        "expression": { "$ref": "#/$defs/gateExpression" },
        "on_pass": { "type": "string", "minLength": 1 },
        "on_pivot": { "type": "string", "minLength": 1 },
        "on_kill": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "order",
        "resource",
        "gpu_class",
        "depends_on",
        "gate_after",
        "max_gpu_seconds",
        "max_wall_time_seconds",
        "max_cost_usd",
        "max_retries",
        "cheaper_smoke_evidence_sha256",
        "paid_launch_approval_sha256",
        "shard_size"
      ],
      "properties": {
        "stage_id": {
          "enum": [
            "preflight",
            "data_and_scorer",
            "behavioral_regime",
            "world_representation",
            "condition_matrix",
            "activation_extraction",
            "probe_localization",
            "matched_swaps",
            "causal_interventions",
            "mediation",
            "ood_evaluation",
            "checkpoint_replication",
            "release"
          ]
        },
        "order": { "type": "integer", "minimum": 0, "maximum": 12 },
        "resource": { "enum": ["cpu", "gpu"] },
        "gpu_class": { "enum": ["CPU", "T4", "L4", "A10", "L40S", "A100-80GB", "H100"] },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "gate_after": {
          "anyOf": [
            { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"] },
            { "type": "null" }
          ]
        },
        "max_gpu_seconds": { "type": "integer", "minimum": 0 },
        "max_wall_time_seconds": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cheaper_smoke_evidence_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "paid_launch_approval_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "shard_size": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resource": { "const": "cpu" } },
            "required": ["resource"]
          },
          "then": {
            "properties": {
              "gpu_class": { "const": "CPU" },
              "max_gpu_seconds": { "const": 0 },
              "cheaper_smoke_evidence_sha256": { "type": "null" },
              "paid_launch_approval_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "resource": { "const": "gpu" } },
            "required": ["resource"]
          },
          "then": {
            "properties": {
              "gpu_class": { "enum": ["T4", "L4", "A10", "L40S", "A100-80GB", "H100"] },
              "max_gpu_seconds": { "type": "integer", "minimum": 1 },
              "cheaper_smoke_evidence_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "properties": { "gpu_class": { "const": "H100" } },
            "required": ["gpu_class"]
          },
          "then": {
            "properties": {
              "resource": { "const": "gpu" },
              "stage_id": {
                "enum": [
                  "world_representation",
                  "activation_extraction",
                  "matched_swaps",
                  "causal_interventions",
                  "mediation",
                  "ood_evaluation",
                  "checkpoint_replication"
                ]
              },
              "cheaper_smoke_evidence_sha256": { "$ref": "#/$defs/sha256" },
              "paid_launch_approval_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "else": {
            "properties": {
              "paid_launch_approval_sha256": {
                "anyOf": [
                  { "$ref": "#/$defs/sha256" },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      ]
    },
    "gateExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "operator", "value"],
          "properties": {
            "metric": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
            "operator": { "enum": ["gt", "gte", "lt", "lte", "eq", "neq", "between_inclusive"] },
            "value": {
              "oneOf": [
                { "type": "number" },
                { "type": "boolean" },
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "prefixItems": [{ "type": "number" }, { "type": "number" }],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/gateExpression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/gateExpression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": { "$ref": "#/$defs/gateExpression" }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "format", "hash", "retention", "publication"],
      "properties": {
        "artifact_type": {
          "enum": [
            "resolved_manifest",
            "validation_report",
            "cost_ledger",
            "h100_preflight",
            "h100_approval",
            "gate_decisions",
            "split_manifest",
            "structured_outputs",
            "world_model_results",
            "latent_index",
            "activation_index",
            "probe_results",
            "swap_results",
            "intervention_results",
            "mediation_results",
            "ood_results",
            "replication_results",
            "reproducibility_report",
            "termination_report"
          ]
        },
        "format": { "type": "string", "minLength": 1 },
        "hash": { "const": "sha256" },
        "retention": { "enum": ["permanent", "through_publication", "ephemeral"] },
        "publication": { "enum": ["public", "gated", "internal", "license_blocked"] }
      }
    }
  }
}
