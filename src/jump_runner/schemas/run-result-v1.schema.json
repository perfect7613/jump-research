{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jump-research.invalid/schemas/run-result-v1.schema.json",
  "title": "JUMP immutable run result v1",
  "type": "object",
  "required": ["schema_version", "status", "metrics", "artifacts", "provenance"],
  "properties": {
    "schema_version": {"const": "jump.run-result/v1"},
    "status": {"enum": ["completed", "failed"]},
    "attempt": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "number"},
          "split": {"type": "string"},
          "condition": {"type": "string"},
          "checkpoint_id": {"type": "string"},
          "world_pair_id": {"type": "string"},
          "timepoint": {},
          "layer": {},
          "ci": {
            "type": "object",
            "properties": {"low": {"type": "number"}, "high": {"type": "number"}},
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256", "media_type"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["manifest_sha256", "run_id", "code_version"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string"},
        "code_version": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
